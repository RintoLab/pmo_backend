# Copy to .env.dev and set development-only overrides below.
# Mise sources this file with Bash for every repository task.
# Keep .env and its values compatible with both dotenv and Bash syntax.
set -a
source "$(dirname "${BASH_SOURCE[0]}")/.env"

# These assignments override values from .env for tasks and their children.
# Keep the development server token out of the shared .env file so ordinary
# rinto-pmo commands can use the production token in their CLI configuration.
RINTO_TOKEN="replace-with-your-development-server-token"

set +a
