# Copy to /etc/rinto-pmo/env on the target machine, fill it in, then
# `chown root:rinto` and `chmod 640`. The deploy workflow never writes this
# file -- these are facts about the installation, not about any particular
# release, and a deploy that re-issued RINTO_TOKEN would log every client out.
#
# It is group-readable because both the service and the Gitea runner need it:
# the runner sources it to migrate and to check that the new release answers.
# Run the runner as `rinto` and this is one group, not two.

# The token every client must send. Agreed in advance: put this same value into
# each client's own configuration (`rinto-pmo config init` asks for it). The
# server refuses every request when this is absent, with `token_not_configured`.
RINTO_TOKEN=

# ecto://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=

# `mix phx.gen.secret` on any machine that has Elixir.
SECRET_KEY_BASE=

PORT=4000

# Optional. `config/runtime.exs` reads these too:
#   POOL_SIZE   database connections, default 10
#   ECTO_IPV6   "true" or "1" to connect to the database over IPv6
#
# SHELL is not listed: `config/runtime.exs` already sets it when a release
# under systemd has none, which erlexec's port process refuses to start without.
