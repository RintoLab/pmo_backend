; Installed once, by root:
;
;   install -m 644 deploy/pmo_backend.service /etc/systemd/system/
;   systemctl daemon-reload
;   systemctl enable pmo_backend
;
; The deploy installs it too, on every run, so this is only needed to bring a
; machine up before there is anything to deploy. See docs/deployment.md.

[Unit]
Description=PMO Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
; The same account the deploy arrives over ssh as, so there is one owner for the
; release directory and no group permissions to get wrong. It does not need to
; read the environment file -- systemd does that as root, before dropping here.
User=deploy
Group=deploy
WorkingDirectory=/apps/pmo_backend

; systemd hands a unit the compiled-in PATH, which is the system directories and
; nothing else -- `pi` is installed under the deploy user and would not be found.
; The node directory rather than a wrapper: pi is a `dist/cli.js` behind a
; `#!/usr/bin/env node` shebang, and its extensions shell out to `node` and
; `npx`, so what is needed on PATH is that directory either way.
;
; Through pi's own `current` symlink rather than the versioned directory it
; points at, so an upgrade that installs a new node does not leave this line
; naming a directory that is no longer there.
;
; Ahead of the environment file deliberately: later assignments win, so the
; r-nacos config can override this without touching the unit.
Environment=PATH=/home/deploy/.local/share/pi-node/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

; Written by the deploy from r-nacos, root:deploy 640 -- systemd reads it as
; root, and `deploy.sh` reads the same file to run migrations. systemd parses this
; format itself, which is the point: a value with a space, a quote or a percent
; sign in it needs no escaping on the way in, and `systemctl show` reports the
; path rather than the values.
;
; No leading `-`: a missing file must stop the unit rather than start a server
; with no database and no token, which boots perfectly and serves nothing.
EnvironmentFile=/etc/pmo_backend/env

ExecStart=/apps/pmo_backend/bin/pmo_backend start
ExecStop=/apps/pmo_backend/bin/pmo_backend stop

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
; `true` would hide the home directory of the very user this runs as, and pi
; lives there: the runtime under ~/.local/share/pi-node, the configuration under
; ~/.pi, and whatever an extension decides to write next. Binding those one at a
; time is a game the extensions keep winning, so the whole of deploy's home
; comes through -- and only deploy's. /home is still an empty tmpfs underneath,
; so /root, /run/user and every other account stay invisible.
;
; What this gives up is small: the service already runs as deploy, and pi runs
; commands as deploy, so the home directory is reachable to it in practice no
; matter what is mounted here.
ProtectHome=tmpfs
BindPaths=/home/deploy
ReadWritePaths=/apps/pmo_backend

[Install]
WantedBy=multi-user.target
