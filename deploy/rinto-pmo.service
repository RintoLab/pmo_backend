; Install to /etc/systemd/system/rinto-pmo.service on the target machine, then
; `systemctl daemon-reload && systemctl enable --now rinto-pmo`.
;
; The release is unpacked at /srv/rinto-pmo/current, which the deploy workflow
; replaces wholesale and then restarts this unit.

[Unit]
Description=Rinto PMO
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=rinto
Group=rinto
WorkingDirectory=/srv/rinto-pmo/current

; Secrets and everything else environment-shaped live here, on the machine,
; owned by root and readable by nobody else. They are a property of this
; installation rather than of any deployment, so the workflow never writes
; them: a deploy that re-issued RINTO_TOKEN would log every client out.
EnvironmentFile=/etc/rinto-pmo/env

ExecStart=/srv/rinto-pmo/current/bin/rinto_pmo start
ExecStop=/srv/rinto-pmo/current/bin/rinto_pmo stop

Restart=on-failure
RestartSec=5

; A release keeps its runtime state under the release directory unless told
; otherwise, and that directory is replaced on every deploy.
Environment=RELEASE_TMP=/var/lib/rinto-pmo/tmp

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/rinto-pmo

[Install]
WantedBy=multi-user.target
