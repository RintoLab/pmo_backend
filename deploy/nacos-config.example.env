# The content of the r-nacos config entry the deploy reads.
#
#   namespace (tenant)  whatever the NACOSNAMESPACE repository variable is
#   group               PMO_BE -- the group names the project
#   dataId              .env   -- the dataId is this file's own name
#   type                text  (it is read back verbatim, not parsed as YAML)
#
# Shaped like a .env file and NOT like `prod.secret.exs`: `config/*.secret.exs`
# is imported by `config/config.exs`, which runs at *compile* time. A release
# only evaluates `config/runtime.exs` when it boots, so a `prod.secret.exs`
# fetched at deploy time would do nothing at all, and one fetched at build time
# would bake these values into the tarball.
#
# The deploy copies this to /etc/pmo_backend/env, which the unit reads as its
# `EnvironmentFile`. systemd parses this format itself, so a value with a space,
# a quote or a percent sign in it needs no escaping.
#
# Every line still has to be KEY=value: no `export`, no shell expansion, no
# multi-line values, and no quotes around values -- nothing runs a shell over
# this file, so a quote would become part of the value.

# --- required ---

# ecto://USER:PASSWORD@HOST/DATABASE -- add ?ssl=true if the server requires it.
# The password has to be percent-encoded if it contains @ : / ? # or % ; the
# simplest way not to care is to generate one without them:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
DATABASE_URL=ecto://pmo:PASSWORD@database.kenton.wang/pmo_prod

# `mix phx.gen.secret`
SECRET_KEY_BASE=

# The token every client must send. Agreed in advance: the same value goes into
# each client's own configuration (`rinto-pmo config init` asks for it).
# Absent means the server answers nothing, with `token_not_configured`.
RINTO_TOKEN=

# --- optional, all read by config/runtime.exs ---

# The credential for the inference service that computes embeddings and does the
# reranking -- `config :rinto_pmo, :ai` names the address, this is the token.
#
# Optional in the sense that the server starts, migrates and answers everything
# else without it. Nothing else about it is gentle: no check refuses the deploy,
# the health check passes, and the release then computes no vectors at all --
# every `embedding` column stays null forever and `GET /search` answers 503
# `ai_not_configured`. The only evidence is one line per pass in the log:
#
#   [warning] embeddings: this server has no RINTO_AI_TOKEN, so nothing can be
#   embedded or found
#
# Adding it later needs no backfill: a row with no vector is the queue, and the
# next pass picks up everything that accumulated. See docs/deployment.md §1.
RINTO_AI_TOKEN=

# The port the release listens on, behind the reverse proxy. It serves plain
# HTTP: TLS and HSTS belong to the proxy, and `config/prod.exs` deliberately
# does not compile `force_ssl` in. See its comment.
PORT=4000

# The name the human actor is created with, the first time a deploy finds the
# database has nobody in it. Ignored once that actor exists -- renaming later is
# `PATCH /api/v1/actors/{id}`. Falls back to $USER, which during a deploy is
# `deploy` -- a serviceable name, but probably not the one you want.
# RINTO_OWNER_NAME=Kenton

# The address clients reach this at, through the proxy. Only used to build
# absolute URLs, which this API does not do -- set it anyway so nothing later
# inherits a wrong one. Defaults to `localhost`.
#
# This is this API's own name, the one the CLI dials. It is NOT where the
# browser comes from -- that is BROWSER_ORIGINS below, and the two are separate
# on purpose.
PHX_HOST=pmo-api.kenton.wang

# The origins a browser may open the WebSocket from, comma-separated, each with
# its scheme. A leading `*.` label is a suffix match.
#
# Needed whenever the frontend is served under a different name than this API.
# Phoenix compares the browser's `Origin` against this list and refuses the
# handshake with a 403 -- before the token in the connect params is even looked
# at. REST calls never reach that check, and the CLI sends no `Origin` at all,
# so a wrong value here looks like "everything works except the socket".
#
# Unset allows only PHX_HOST itself, which is the case where the frontend and
# this API answer to the same name.
BROWSER_ORIGINS=https://pmo.kenton.wang

# Database connections. Default 10.
# POOL_SIZE=10

# "true" or "1" to reach the database over IPv6.
# ECTO_IPV6=false

# Distributed Erlang. `mix release` bakes a random one into every build, so two
# builds cannot see each other unless this is set. Only needed for clustering
# or for `bin/pmo_backend remote` against a differently-built release.
# RELEASE_COOKIE=
