#!/bin/sh
# Sourced by every `bin/rinto_pmo` invocation, including `start`, `eval`,
# `remote` and `stop`. `mix release` renders this from `rel/env.sh.eex` at build
# time; the default it would otherwise generate is entirely comments.

# Distributed Erlang, bound to loopback.
#
# It cannot simply be turned off: `ExecStop=bin/rinto_pmo stop` in the systemd
# unit talks to the running node, and so do `remote` and `rpc`. But it does not
# need to be reachable from anywhere else -- everything that uses it runs on
# this machine, and the deploy arrives over ssh rather than over distribution.
#
# Left at the default, `epmd` listens on 0.0.0.0:4369 and the node takes a
# random port on every interface. Anyone on the network who has the cookie then
# has a shell in the VM, which is every permission the application has. The
# cookie is generated per build and readable only by the release's owner, so
# that is a second lock rather than the only one -- this closes the first.
#
# Set DNS_CLUSTER_QUERY and remove these two lines to cluster; see
# https://hexdocs.pm/phoenix/releases.html#clustering
export ERL_EPMD_ADDRESS=127.0.0.1
export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_use_interface {127,0,0,1}"
