# Application runtime (required in production)
DATABASE_URL=ecto://postgres:postgres@localhost/rinto_pmo_prod
SECRET_KEY_BASE=replace-with-the-output-of-mix-phx-gen-secret

# Optional tooling integration
APIFOX_ACCESS_TOKEN=

# Comma-separated origins allowed to access Tidewave remotely in development.
# Tidewave supports wildcard host prefixes such as `*.`.
TIDEWAVE_ALLOWED_ORIGINS=

# in dev
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

AI_BASE_URL=
AI_TOKEN=
