{
  "mcpServers": {
    "apifox-pmo": {
      "command": "npx",
      "args": [
        "-y",
        "apifox-mcp-server@latest",
        "--project=8652400"
      ],
      "env": {
        "APIFOX_ACCESS_TOKEN": "${APIFOX_ACCESS_TOKEN}"
      }
    },
    "tidewave": {
      "type": "http",
      "url": "http://localhost:4000/tidewave/mcp?include_browser_tools=false",
      "directTools": true,
      "_source": "pi-acp-tidewave-sync"
    }
  }
}
